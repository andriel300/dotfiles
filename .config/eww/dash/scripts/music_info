#!/bin/bash

COVER="/tmp/.music_cover.jpg"

## Get status (playing/paused)
get_status() {
	status=$(playerctl status 2>/dev/null)
	if [[ "$status" == "Playing" ]]; then
		echo ""
	else
		echo "喇"
	fi
}

## Get song title
get_song() {
	title=$(playerctl metadata title 2>/dev/null)
	[[ -z "$title" ]] && echo "Offline" || echo "$title"
}

## Get artist
get_artist() {
	artist=$(playerctl metadata artist 2>/dev/null)
	[[ -z "$artist" ]] && echo "Offline" || echo "$artist"
}

## Get current time (ctime)
get_ctime() {
	pos=$(playerctl position 2>/dev/null)
	printf "%d:%02d\n" $(($pos / 60)) $(($pos % 60))
}

## Get total time (ttime)
get_ttime() {
	dur=$(playerctl metadata mpris:length 2>/dev/null)
	if [[ -z "$dur" || "$dur" == "0" ]]; then
		echo "0:00"
	else
		# playerctl returns microseconds
		seconds=$((dur / 1000000))
		printf "%d:%02d\n" $(($seconds / 60)) $(($seconds % 60))
	fi
}

## Get percentage of playback
get_time() {
	pos=$(playerctl position 2>/dev/null)
	dur=$(playerctl metadata mpris:length 2>/dev/null)

	if [[ -z "$pos" || -z "$dur" || "$dur" == "0" ]]; then
		echo "0"
	else
		# Convert duration to seconds
		dur_s=$((dur / 1000000))
		awk -v p="$pos" -v d="$dur_s" 'BEGIN { printf "%.0f", (p/d)*100 }'
	fi
}

## Get cover art
get_cover() {
	url=$(playerctl metadata mpris:artUrl 2>/dev/null | sed 's/^file:\/\///')
	if [[ -f "$url" ]]; then
		cp "$url" "$COVER"
		echo "$COVER"
	else
		echo "images/music.png"
	fi
}

## Controls
toggle() {
	playerctl play-pause
}

next() {
	playerctl next
	get_cover
}

prev() {
	playerctl previous
	get_cover
}

## Dispatch
case "$1" in
--status) get_status ;;
--song) get_song ;;
--artist) get_artist ;;
--ctime) get_ctime ;;
--ttime) get_ttime ;;
--time) get_time ;;
--cover) get_cover ;;
--toggle) toggle ;;
--next) next ;;
--prev) prev ;;
*) echo "Comando inválido" ;;
esac
