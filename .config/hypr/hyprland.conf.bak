# ANDRIEL'S HYPRLAND CONFIG

source=~/.config/hypr/scripts
source=~/.config/hypr/fast-animations.conf
source=~/.config/hypr/keybinding.conf

# set Scripts
$HYPRSCRIPTS = ~/.config/hypr/scripts

################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
monitor=DP-3, 1920x1080@165, 0x0,1, vrr, 1, cm, auto, sdrbrightness,1.4, sdrsaturation,1.0


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

#exec-once = /usr/bin/agsv1 # run hyprpanel
exec-once = hyprpanel
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME # for XDPH
exec-once = dbus-update-activation-environment --systemd --all # for XDPH
exec-once = nm-applet --indicator # systray app for Network/Wifi
exec-once = udiskie --no-automount --smart-tray
exec-once = hypridle
exec-once = hyprctl setcursor Bibata-Modern-Ice 24
exec-once = hyprpm reload -n
exec-once = $HYPRSCRIPTS/hyprsocket.sh # IPC EVENTS
exec-once = $HYPRSCRIPTS/cleanup.sh # cleanup

#exec-once = ~/.config/hypr/scripts/wallpaper-restore.sh

# fallbacks execs
#exec-once = hyprpaper # basic wallpaper from the oven hyprland
#exec-once = /usr/bin/wpaperd -d # dynamic changing wallpaper
#exec-once = waybar # fallback waybar just in case.
#exec-once = swww-daemon
#exec-once = sh ./random_wallpaper.sh ~/.config/backgrounds/wallpapers

#exec-once = systemctl --user start hyprpolkitagent

exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = wl-paste --type text --watch cliphist store # Stores only text data
exec-once = wl-paste --type image --watch cliphist store # Stores only image data

#exec-once = sh ~/.config/hypr/scripts/andrielBorders.sh # rainbow borders color script
#exec-once = sh $HYPRSCRIPTS/set_catppuccin_borders.sh

############################r
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hyprland.org/Configuring/Environment-variables/

# experimental hdr env
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = HYPRCURSOR_THEME,Bibata-Modern-Ice
env = HYPRCURSOR_SIZE,24

env = PATH,$PATH:$HYPRSCRIPTS

env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_MENU_PREFIX,arch-

env = QT_QPA_PLATFORM,wayland;xcb
env = QT_QPA_PLATFORMTHEME,qt6ct
env = QT_QPA_PLATFORMTHEME,qt5ct
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
env = QT_SCALE_FACTOR,1
env = QT_STYLE_OVERRIDE,kvantum

env = CLUTTER_BACKEND,wayland

env = MOZ_ENABLE_WAYLAND,1
env = GDK_SCALE,1
# electron >28 apps (may help)
env = ELECTRON_OZONE_PLATFORM_HINT,auto
# grimblast screenshot
env = GRIMBLAST_HIDE_CURSOR, 0 #Stops hyprpanel/hyprland from crashing when screenshoting with grimblast
#env = agsv1,/usr/bin/agsv1
env = WAYLAND_DISPLAY, wayland-0
env = DXVK_HDR, 1
env = ENABLE_HDR_WSI, 1
render {
    direct_scanout = 2
    cm_fs_passthrough = 1
}

blurls = code-oss
blurls = waybar

#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hyprland.org/Configuring/Variables/

# https://wiki.hyprland.org/Configuring/Variables/#general
general { 
    gaps_in = 10
    gaps_out = 20
    gaps_workspaces = 50

    border_size = 0

    # https://wiki.hyprland.org/Configuring/Variables/#variable-types for info about colors
  #col.active_border = rgb(8aadf4) rgb(c6a0f6) 45deg
  #col.inactive_border = rgba(595959aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = true
    no_focus_fallback = true

    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
    allow_tearing = true

    layout = dwindle
}

plugin {
  hyprfocus {
    enabled = yes
    animate_floating = no
    animate_workspacechange = no
    focus_animation = flash
      # Beziers for focus animations
    bezier = bezIn, 0.5, 0.0, 1.0, 0.5
    bezier = bezOut, 0.0, 0.5, 0.5, 1.0
    bezier = overshot, 0.05, 0.9, 0.1, 1.05
    bezier = smoothOut, 0.36, 0, 0.66, -0.56
    bezier = smoothIn, 0.25, 1, 0.5, 1
    bezier = realsmooth, 0.28, 0.29, 0.69, 1.08
    bezier = easeInOutBack, 0.68, -0.6, 0.32, 1.6
      # Flash settings
    flash {
      flash_opacity = 0.7
      in_bezier = bezIn
      in_speed = 0.5
      out_bezier = bezOut
      out_speed = 3
    }
      # Shrink settings
    shrink {
      shrink_percentage = 0.99
      in_bezier = easeInOutBack
      in_speed = 1.5
      out_bezier = easeInOutBack
      out_speed = 3
    }
  }
}

# https://wiki.hyprland.org/Configuring/Variables/#decoration
decoration {
    rounding = 8

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 1.0
    fullscreen_opacity = 1.0

    # Shadow
    shadow {
        enabled = true
        ignore_window = true
        range = 30
        offset = 0 2
        render_power = 3
        color = rgba(0000002A)
    }

    # https://wiki.hyprland.org/Configuring/Variables/#blur
    blur {
        enabled = true
        xray = true
        special = true
        new_optimizations = true
        size = 10
        passes = 3
        blurls = waybar
        ignore_opacity = true
  }

      # Dim
    dim_inactive = true
    dim_strength = 0.1
    dim_special = 0
}


# See https://wiki.hyprland.org/Configuring/Dwindle-Layout/ for more
dwindle {
    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
    preserve_split = true
    smart_split = false
    smart_resizing = false
}

# See https://wiki.hyprland.org/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# https://wiki.hyprland.org/Configuring/Variables/#misc
misc {
    vfr = 1
    vrr = 1
    animate_manual_resizes = false
    animate_mouse_windowdragging = false
    enable_swallow = false
    swallow_regex = (com.mitchellh.ghostty|foot|kitty|allacritty|Alacritty)
    
    disable_hyprland_logo = true
    force_default_wallpaper = 0
    new_window_takes_over_fullscreen = 2
    allow_session_lock_restore = true
    
    initial_workspace_tracking = false
    focus_on_activate = true
}

#############
### INPUT ###
#############

# https://wiki.hyprland.org/Configuring/Variables/#input
input {
    kb_layout = br
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =
    numlock_by_default = true
    repeat_delay = 250
    repeat_rate = 35
  

    follow_mouse = 1
    force_no_accel = 1
    special_fallthrough = true

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = yes
        disable_while_typing = true
        clickfinger_behavior = true
        scroll_factor = 0.5
    }
}

binds {
    # focus_window_on_workspace_c# For Auto-run stuff see execs.confhange = true
    scroll_event_delay = 0
}

# https://wiki.hyprland.org/Configuring/Variables/#gestures
gestures {
    workspace_swipe = true
    workspace_swipe_distance = 700
    workspace_swipe_fingers = 4
    workspace_swipe_cancel_ratio = 0.2
    workspace_swipe_min_speed_to_force = 5
    workspace_swipe_direction_lock = true
    workspace_swipe_direction_lock_threshold = 10
    workspace_swipe_create_new = true
}

# Example per-device config
# See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more
device {
  name = epic-mouse-v1
    sensitivity = -0.5
}

# No Hardware Cursor
cursor {
    no_hardware_cursors = true
}

##############################
### WINDOWS AND WORKSPACES ###
##############################

windowrule = suppressevent maximize, class:.* # You'll probably like this.

# windowrule v2 to avoid idle for fullscreen apps
#windowrule = idleinhibit fullscreen, class:^(*)$
#windowrule = idleinhibit fullscreen, title:^(*)$
windowrule = idleinhibit fullscreen, fullscreen:1

# Emoji Picker Smile
windowrule = float,class:(it.mijorus.smile)
windowrule = pin, class:(it.mijorus.smile)
windowrule = move 100%-w-40 90,class:(it.mijorus.smile)

# qbittorrent
windowrule = float,class:(org.qbittorrent.qBittorrent)
windowrule = size 1280 720,class:(org.qbittorrent.qBittorrent)

# Gnome Calculator
windowrule = float,class:(gnome.calculator)
windowrule = size 700 600,class:(gnome.calculator)
windowrule = center,class:(gnome.calculator)

# Browser settings
windowrule = float, title:^(Page Info)(.*)$, class:^(zen)$
windowrule = float, title:^(About Zen Browser)(.*)$, class:^(zen)$
windowrule = float,class:^(zen)$,title:^(Extension: \(Bitwarden Password Manager\))$
windowrule = float, title:^(Extension: \(Extension: \(Bitwarden Password Manager) - Bitwarden — Zen Browser\))$
windowrule = float, title:^(Picture-in-Picture)$
windowrule = pin, title:^(Picture-in-Picture)$
#windowrule = noblur, title:^(Picture-in-Picture)$
#windowrule = nodim, title:^(Picture-in-Picture)$
windowrule = move 100%-785 100%-486, title:^(Picture-in-Picture)$
windowrule = size 785 486, title:^(Picture-in-Picture)$
windowrule = opacity 1.0 1.0, title:^(Picture-in-Picture)$
windowrule = keepaspectratio, title:^(Picture-in-Picture)$
#windowrule = opacity 0.9 0.7, class:^(zen)$ # zen browser

# Fix some dragging issues with XWayland
windowrule = nofocus,class:^$,title:^$,xwayland:1,floating:1,fullscreen:0,pinned:0

# testing steam config rules
windowrule = fullscreen,class:^steam_app\d+$
windowrule = monitor 1,class:^steam_app_\d+$
windowrule = workspace 10,class:^steam_app_\d+$
workspace = 10, border:false, rounding:false

# Steam (Library, Store)
windowrule = float, class:^(steamwebhelper)$
windowrule = size 800 600, class:^(steamwebhelper)$
windowrule = center, class:^(steamwebhelper)$
windowrule = float, class:^([Ss]team)$, title:^((?![Ss]team).*)$
windowrule = workspace 3 silent, class:^([Ss]team)$, title:^([Ss]team)$
windowrule = tile, class:^([Ss]team)$, title:^([Ss]team)$
windowrule = float, class:^([Ss]team)$, title:negative:^([Ss]team)$
windowrule = opacity 0.70 $& 0.70 $& 1,class:^([Ss]team)$
windowrule = opacity 0.70 $& 0.70 $& 1,class:^(steamwebhelper)$

# Terminals
windowrule = opacity 0.9 0.9, class:^(com.mitchellh.ghostty)$
windowrule = opacity 0.90, class:^(kitty)$

#media
# Disable idle/lock for APPs
windowrule = idleinhibit, class:^(vlc)$
#windowrule = float,class:^(vlc)$

# Waypaper
windowrule = float,class:(.*waypaper.*)
windowrule = size 900 700,class:(.*waypaper.*)
windowrule = center,class:(.*waypaper.*)
windowrule = pin,class:(.*waypaper.*)

windowrule = float,class:^(kvantummanager)$
windowrule = float,class:^(qt5ct)$
windowrule = float,class:^(qt6ct)$
windowrule = opacity 0.80 0.70,class:^(org.kde.polkit-kde-authentication-agent-1)$
windowrule = opacity 0.80 0.70,class:^(polkit-gnome-authentication-agent-1)$

# common modals
windowrule = float,title:^(Open)$
windowrule = float,title:^(Open Files)$
windowrule = float,title:^(Choose Files)$
windowrule = float,title:^(Save As)$
windowrule = float,title:^(Confirm to replace files)$
windowrule = float,title:^(File Operation Progress)$
windowrule = float,class:^(xdg-desktop-portal-gtk)$

windowrule = opacity 0.70 $& 0.70 $& 1,initialTitle:^(Spotify Free)$
windowrule = opacity 0.70 $& 0.70 $& 1,initialTitle:^(Spotify Premium)$
windowrule = opacity 0.80 0.80,class:^(vesktop)$ # Vesktop
windowrule = opacity 0.80 0.80,class:^(discord)$ # Discord-Electron
windowrule = opacity 0.80 0.80,class:^(WebCord)$ # WebCord-Electron
windowrule = opacity 0.80 0.80,class:^(ArmCord)$ # ArmCord-Electron
windowrule = float,class:^(nwg-look)$
# nwg-look
windowrule = float,class:(nwg-displays)
windowrule = size 700 600,class:(nwg-displays)
windowrule = move 10% 20%,class:(nwg-displays)
windowrule = pin,class:(nwg-displays)

windowrule = opacity 0.90 0.90,class:^(com.rtosta.zapzap)$
windowrule = opacity 0.80 $& 0.80 $& 1,class:^(org.kde.dolphin)$
windowrule = opacity 0.80 $& 0.80 $& 1,class:^(org.kde.ark)$
windowrule = opacity 0.80 0.80,class:^(qBittorrent)$
windowrule = opacity 0.80 0.80,class:^(org.gnome.Nautilus)
windowrule = float,class:^(org.gnome.Nautilus)
windowrule = size 1280 720,class:^(org.gnome.Nautilus)
windowrule = opacity 0.80 $& 0.70 $& 1,class:^(org.freedesktop.impl.portal.desktop.gtk)$
windowrule = opacity 0.80 $& 0.70 $& 1,class:^(org.freedesktop.impl.portal.desktop.hyprland)$
windowrule = opacity 0.80 $& 0.70 $& 1,class:^(org.kde.polkit-kde-authentication-agent-1)$
windowrule = opacity 0.80 $& 0.70 $& 1,class:^(polkit-gnome-authentication-agent-1)$
windowrule = float,class:^(org.kde.dolphin)$,title:^(Progress Dialog — Dolphin)$
windowrule = float,class:^(org.kde.dolphin)$,title:^(Copying — Dolphin)$
windowrule = float,class:^(com.mitchellh.ghostty)$,title:^(top)$
windowrule = float,class:^(com.mitchellh.ghostty)$,title:^(btop)$
windowrule = float,class:^(com.mitchellh.ghostty)$,title:^(htop)$
windowrule = float,class:^(org.kde.polkit-kde-authentication-agent-1)$
windowrule = float,class:^(org.kde.ark)$
windowrule = float,class:^(firefox)$,title:^(Library)$
windowrule = float,class:^(zen)$,title:^(Library)$
windowrule = float,class:^(eog)$ # Imageviewer-Gtk
windowrule = float,class:^(swayimg)$ # Imageviewer sway
windowrule = size 800 600,class:^(swayimg)$ # Imageviewer sway
windowrule = float, class:(io.missioncenter.MissionCenter)
windowrule = pin, class:(io.missioncenter.MissionCenter)
windowrule = center, class:(io.missioncenter.MissionCenter)
windowrule = size 900 600, class:(io.missioncenter.MissionCenter)

# System Mission Center Preference Window
windowrule = float, class:(missioncenter), title:^(Preferences)$
windowrule = pin, class:(missioncenter), title:^(Preferences)$
windowrule = center, class:(missioncenter), title:^(Preferences)$

windowrule = float, class:(evince)
windowrule = size 1280 720, class:(evince)

windowrule = float, class:(7zFM)
windowrule = size 800 600, class:(7zFM)
windowrule = pin, class:(7zFM)
windowrule = move 100%-w-40 90, class:(7zFM)
windowrule = opacity 0.90 0.90, class:(7zFM)

windowrule = float, class:(com.usebottles.bottles)
windowrule = size 800 600, class:(com.usebottles.bottles)

# █░░ ▄▀█ █▄█ █▀▀ █▀█   █▀█ █░█ █░░ █▀▀ █▀
# █▄▄ █▀█ ░█░ ██▄ █▀▄   █▀▄ █▄█ █▄▄ ██▄ ▄█

layerrule = blur,wofi
layerrule = blur, rofi
layerrule = blur,notifications
layerrule = ignorezero,notifications
layerrule = ignorezero,rofi
layerrule = noanim, hyprpicker
layerrule = noanim, selection
layerrule = blur,logout_dialog
layerrule = blur, bar-0
# layerrule = blur, indicator
layerrule = blur, waybar # Add blur to waybar
layerrule = blurpopups, waybar # Blur waybar popups too!
layerrule = ignorealpha 0.2, waybar # Make it so transparent parts are ignored
