#!/bin/bash

# Play screenshot sound
~/.config/hypr/scripts/play-sound.sh screenshot &

# Source user directories if available
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs

# Set output directory with fallbacks
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

# Create directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

if [[ ! -d "$OUTPUT_DIR" ]]; then
	notify-send "Screenshot directory does not exist: $OUTPUT_DIR" -u critical -t 3000
	exit 1
fi

# Check if required tools are available
if ! command -v satty &>/dev/null; then
	notify-send "satty is not installed!" -u critical -t 3000
	exit 1
fi

# Take screenshot based on mode
case "${1:-region}" in
"window")
	hyprshot -m window --raw
	;;
"output")
	hyprshot -m output --raw
	;;
*)
	hyprshot -m region --raw
	;;
esac | satty --filename - \
	--output-filename "$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png" \
	--early-exit \
	--actions-on-enter save-to-clipboard \
	--save-after-copy \
	--copy-command 'wl-copy'
